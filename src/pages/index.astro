---
/*
  Rencana halaman (Taste Skill)
  1  kind: service (lomba EXPO TRPL 2026 untuk siswa SMK se-Lampung, penyelenggara TRPL Polinela)
  2  deal: hero word (statis, tanpa kata berganti) · palet brand dari sampul (teal/peach/off-white)
     · font Oswald + Manrope (+ Sacramento satu kali) sesuai brief · nav-mega → nav-centre (one-page, tanpa isi panel)
     · footer-dark · close-photo → close-word (tidak ada foto) · ritme ground teal/terang bergantian (brief)
     · tombol solid · moment word-highlight di About
  home          poster DIGITAL CANVAS + identitas + fakta            1 layar
  about         pernyataan (word-highlight) + tiga tahap tagline      1 layar
  about detail  apa/mengapa/siapa/manfaat + sampul Guide Book          1 layar
  lomba         empat cabang lomba + guidebook masing-masing          1 layar
  timeline      lima tahap lomba                                      1 layar
  registration  info, persyaratan, cara daftar | kategori + GForm    2 layar
  faq           pertanyaan pendaftaran                                1 layar
  footer        penutup + direktori                                   1 layar
*/
import MainLayout from '../layouts/MainLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Competitions from '../components/Competitions.astro';
import Timeline from '../components/Timeline.astro';
import Registration from '../components/Registration.astro';
import FAQ from '../components/FAQ.astro';
import Footer from '../components/Footer.astro';
---

<MainLayout>
  <Navbar />
  <main id="main" tabindex="-1" class="outline-none">
    <Hero />
    <About />
    <Competitions />
    <Timeline />
    <Registration />
    <FAQ />
  </main>
  <Footer />
</MainLayout>
