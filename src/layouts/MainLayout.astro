---
import '../styles/global.css';
import { site } from '../config/site';
import { event } from '../data/event';
import { isValidHttpsUrl, missingFields } from '../utils/event-helpers';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;

// Canonical & og:url hanya bila URL produksi diketahui (SITE_URL saat build).
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : null;
const ogImage = Astro.site ? new URL(site.ogImage, Astro.site).href : site.ogImage;

// Structured data Event hanya bila tanggal & lokasi sudah pasti (tidak mengarang data).
const canStructure = Boolean(event.dateStart && event.venue && event.city);
const jsonLd = canStructure
  ? {
      '@context': 'https://schema.org',
      '@type': 'EducationEvent',
      name: event.name,
      description: event.description,
      startDate: event.dateStart,
      ...(event.dateEnd ? { endDate: event.dateEnd } : {}),
      eventAttendanceMode:
        event.mode === 'Daring'
          ? 'https://schema.org/OnlineEventAttendanceMode'
          : event.mode === 'Hybrid'
            ? 'https://schema.org/MixedEventAttendanceMode'
            : 'https://schema.org/OfflineEventAttendanceMode',
      location: {
        '@type': 'Place',
        name: event.venue,
        address: { '@type': 'PostalAddress', addressLocality: event.city, addressCountry: 'ID' },
      },
      organizer: {
        '@type': 'EducationalOrganization',
        name: `${event.organizer.studyProgram}, ${event.organizer.institution}`,
      },
      ...(Astro.site ? { url: Astro.site.href } : {}),
    }
  : null;

// Laporan data yang masih kosong, dicetak saat build/dev (tidak tampil di situs).
const missing = missingFields(event);
if (missing.length) {
  console.warn(
    `\n[Digital Canvas] ${missing.length} informasi acara belum diisi di src/data/event.ts:\n` +
      missing.map((m) => `  - ${m}`).join('\n') +
      '\n',
  );
}
const sameAs = event.socials.map((s) => s.url).filter(isValidHttpsUrl);
---

<!doctype html>
<html lang={site.lang} data-type="service">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="page-type" content="service" />
    <meta name="site-kind" content="other" />
    <meta name="theme-color" content={site.themeColor} />
    <meta name="generator" content={Astro.generator} />
    {canonical && <link rel="canonical" href={canonical} />}
    <!-- canonical URL: aktif otomatis setelah SITE_URL diisi saat build -->

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={event.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.ogImageAlt} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify({ ...jsonLd, sameAs })} />}

    <!-- Tandai JS aktif sebelum paint: animasi masuk hero hanya berjalan bila JS ada. -->
    <script is:inline>
      document.documentElement.classList.add('js', 'mo-js', 'm-enter');
      setTimeout(() => document.documentElement.classList.add('m-enter-done'), 900);
      setTimeout(() => document.documentElement.classList.add('mo-safe'), 2500);
    </script>
    <!-- Moment "word-highlight" dari kit Taste Skill (file kit asli, tidak diubah). -->
    <link rel="modulepreload" href="/assets/moments/moments.js" />
    <link rel="modulepreload" href="/assets/moments/lib.js" />
    <link rel="modulepreload" href="/assets/moments/word-highlight/moment.js" />
    <script type="module" src="/assets/moments/moments.js" is:inline></script>
  </head>
  <body>
    <!-- Filter SVG untuk tepi bingkai bergerigi (dipakai .rough-frame). -->
    <svg width="0" height="0" aria-hidden="true" focusable="false" style="position:absolute">
      <filter id="rough-edge" x="-5%" y="-5%" width="110%" height="110%">
        <feTurbulence type="fractalNoise" baseFrequency="0.035 0.09" numOctaves="2" seed="7" result="noise"></feTurbulence>
        <feDisplacementMap in="SourceGraphic" in2="noise" scale="4" xChannelSelector="R" yChannelSelector="G"></feDisplacementMap>
      </filter>
    </svg>
    <slot />
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
