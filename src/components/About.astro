---
import { Picture } from 'astro:assets';
import guidebookCover from '../assets/guidebook-cover.jpeg';
import { event } from '../data/event';
import { Hammer, Lightbulb, Presentation, Handshake, Info, Target, Users, Trophy } from '@lucide/astro';
import IconTile from './IconTile.astro';
import { TBA } from '../utils/event-helpers';

// Kata kunci pada pernyataan yang menyala dengan warna aksen (moment word-highlight).
const KEY = /^(ui\/ux|web|poster|reels)[,.:]?$/i;
const tokens = event.about.statement.split(/\s+/).map((w) => ({ w, key: KEY.test(w) }));

// Tiga tahap dari tagline sampul.
const pillars = [
  { no: '01', en: 'Build Skills', id: 'Asah kemampuan', icon: Hammer },
  { no: '02', en: 'Challenge Ideas', id: 'Uji ide di lomba', icon: Lightbulb },
  { no: '03', en: 'Present Solutions', id: 'Presentasikan solusi', icon: Presentation },
  { no: '04', en: 'Collaboration', id: 'Berkarya bersama tim', icon: Handshake },
];

const details = [
  { q: 'Apa itu Digital Canvas', a: event.about.what, icon: Info },
  { q: 'Mengapa diadakan', a: event.about.why, icon: Target },
  { q: 'Siapa yang bisa ikut', a: event.about.who, icon: Users },
];
---

<!-- About 1/2: pernyataan acara (moment word-highlight) -->
<section id="about" class="section on-light bg-paper" aria-labelledby="about-title">
  <div class="wrap flex min-h-[calc(100svh-var(--padt)-var(--padb))] flex-col">
    <p class="label text-muted">About</p>
    <h2 id="about-title" class="h2 mt-4 max-w-[16ch]">Tentang Digital Canvas</h2>

    <p
      class="mt-10 max-w-[30ch] font-display text-statement leading-[var(--text-statement--line-height)] font-medium sm:max-w-[34ch] md:text-[3.25rem] lg:mt-12 lg:text-statement"
      data-moment="word-highlight"
      role="group"
    >
      {
        tokens.map(({ w, key }, i) => (
          <>
            {key ? <strong class="font-semibold">{w}</strong> : w}
            {i < tokens.length - 1 ? ' ' : ''}
          </>
        ))
      }
    </p>

    <ol class="mt-auto grid gap-0 pt-12 sm:grid-cols-2 sm:gap-x-6 lg:grid-cols-4">
      {
        pillars.map((p) => (
          <li class="flex items-center gap-4 border-t border-line py-3.5 sm:block sm:py-5">
            <div class="flex items-center justify-between sm:mb-4">
              <IconTile icon={p.icon} size="md" />
              <span class="hidden font-display text-small font-semibold text-teal-deep sm:inline">{p.no}</span>
            </div>
            <div class="min-w-0">
              <span class="block font-display text-h3 leading-tight font-semibold">{p.en}</span>
              <span class="block text-small text-muted sm:mt-1">{p.id}</span>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<!-- About 2/2: detail editorial + sampul Guide Book -->
<section class="section on-dark relative overflow-hidden bg-ocean text-paper max-sm:[--hm:2]" aria-labelledby="about-detail-title">
  <div class="wrap grid gap-y-12 max-sm:grid-rows-[1fr_auto] max-sm:min-h-[calc(200svh-var(--padt)-var(--padb))] md:grid-cols-12 md:gap-x-6">
    <div class="flex flex-col md:col-span-7">
      <h2 id="about-detail-title" class="h2">
        Empat lomba, <span class="text-peach">satu tema</span>
      </h2>

      <dl class="mt-8 flex flex-col max-sm:flex-1 max-sm:justify-between lg:mt-10">
        {
          details.map((d) => (
            <div class="grid grid-cols-[2.75rem_1fr] gap-x-4 gap-y-1 border-t border-line-dark py-4">
              <IconTile icon={d.icon} tone="dark" size="md" class="row-span-2" />
              <dt class="font-display text-[1.0625rem] font-medium tracking-wide uppercase">{d.q}</dt>
              <dd class:list={['col-start-2', !d.a && 'font-semibold text-peach']}>{d.a ?? TBA}</dd>
            </div>
          ))
        }
        <div class="grid grid-cols-[2.75rem_1fr] gap-x-4 gap-y-1 border-y border-line-dark py-4">
          <IconTile icon={Trophy} tone="dark" size="md" class="row-span-2" />
          <dt class="font-display text-[1.0625rem] font-medium tracking-wide uppercase">Yang kamu dapat</dt>
          <dd class="col-start-2">
            <ul class="space-y-1.5">
              {
                event.about.gains.map((g) => (
                  <li class="flex gap-3">
                    <span class="mt-[0.7em] h-px w-4 shrink-0 bg-peach" aria-hidden="true" />
                    {g}
                  </li>
                ))
              }
            </ul>
          </dd>
        </div>
      </dl>

    </div>

    <div class="relative mx-auto w-full max-w-[24rem] md:col-span-5 md:col-start-8 md:mx-0 md:max-w-none">
      <div class="zoom-frame relative ml-auto aspect-[2403/3375] max-h-[calc(100svh-var(--padt)-var(--padb)-10px)] rounded-sm shadow-print">
        <Picture
          src={guidebookCover}
          alt="Sampul Guide Book Digital Canvas: Software Engineering Bootcamp & Competition (EXPO TRPL 2026), Prodi TRPL Politeknik Negeri Lampung"
          width={720}
          widths={[360, 520, 720, 1040]}
          sizes="(min-width: 1024px) 34vw, (min-width: 640px) 26rem, 90vw"
          formats={['avif', 'webp']}
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover"
        />
      </div>
    </div>
  </div>
</section>
