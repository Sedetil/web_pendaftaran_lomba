---
import { ArrowUpRight, MessageCircleQuestionMark } from '@lucide/astro';
import { event } from '../data/event';
import { isValidFormUrl, isValidHttpsUrl } from '../utils/event-helpers';

// Hanya pertanyaan yang jawabannya sudah dikonfirmasi panitia.
const formOpen = isValidFormUrl(event.registration.formUrl);
const items = event.faq.filter(
  (f): f is { question: string; answer: string } => Boolean(f.answer) && !(f.onlyWhileFormClosed && formOpen),
);
const ask = event.socials.find((s) => isValidHttpsUrl(s.url));
---

{
  items.length > 0 && (
    <section id="faq" class="section on-light bg-paper max-sm:[--hm:2]" aria-labelledby="faq-title">
      <div class="wrap grid gap-y-8 sm:gap-y-10 max-sm:flex max-sm:flex-col max-sm:min-h-[calc(200svh-var(--padt)-var(--padb))] md:grid-cols-12 md:gap-x-6">
        <div class="md:col-span-6 lg:col-span-4">
          <p class="label text-muted">FAQ</p>
          <h2 id="faq-title" class="h2 mt-4 max-w-[12ch]">
            Pertanyaan seputar pendaftaran
          </h2>
          <p class="mt-6 max-w-[38ch] text-lead">
            Jawaban singkat untuk hal yang paling sering ditanyakan calon peserta.
          </p>
          {ask && (
            <div class="mt-7 border-t-2 border-peach pt-5 sm:mt-10">
              <div>
                <p class="flex items-center gap-2.5 font-medium">
                  <MessageCircleQuestionMark size={22} aria-hidden="true" class="shrink-0 text-teal-deep" />
                  Pertanyaanmu belum terjawab?
                </p>
                <a href={ask.url} target="_blank" rel="noopener noreferrer" class="btn btn--secondary mt-3">
                  Tanya panitia di {ask.label}
                  <ArrowUpRight size={18} aria-hidden="true" />
                  <span class="sr-only">(membuka tab baru)</span>
                </a>
              </div>
            </div>
          )}
        </div>

        <dl class="border-b border-line max-sm:flex max-sm:flex-1 max-sm:flex-col max-sm:justify-between md:col-span-6 md:col-start-7 lg:col-span-7 lg:col-start-6">
          {items.map((f, i) => (
            <div class="grid grid-cols-[2.75rem_1fr] gap-x-2 border-t border-line py-3.5 sm:py-4 lg:py-[1.125rem]">
              <dt class="col-span-2 grid grid-cols-subgrid font-display text-[1.375rem] leading-snug font-medium lg:text-[1.375rem]">
                <span class="pt-1 text-[1.0625rem] font-semibold text-teal-deep" aria-hidden="true">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span>{f.question}</span>
              </dt>
              <dd class="col-start-2 mt-1 max-w-[64ch]">{f.answer}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
  )
}
