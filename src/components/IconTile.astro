---
/**
 * Ikon Lucide di dalam kotak bergaris tipis — satu gaya untuk semua section.
 * tone "light" untuk ground terang (paper/surface), "dark" untuk ground teal.
 */
interface Props {
  icon: any;
  tone?: 'light' | 'dark';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
}
const { icon: Icon, tone = 'light', size = 'md', class: className = '' } = Astro.props;

const box = { sm: 'size-9', md: 'size-11', lg: 'size-14' }[size];
const glyph = { sm: 18, md: 22, lg: 28 }[size];
---

<span
  class:list={[
    'inline-grid shrink-0 place-items-center rounded-sm border',
    box,
    tone === 'light' ? 'border-teal-deep/25 bg-teal-deep/[0.07] text-teal-deep' : 'border-peach/40 bg-peach/10 text-peach',
    className,
  ]}
  aria-hidden="true"
>
  <Icon size={glyph} stroke-width={1.6} />
</span>
