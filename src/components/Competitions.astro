---
import fs from 'node:fs';
import path from 'node:path';
import { FileText, MousePointerClick, CodeXml, Palette, Clapperboard, Users, Flag, MessageCircle } from '@lucide/astro';
import { event } from '../data/event';

// Ikon per cabang lomba (berdasarkan id di event.ts).
const ICONS = { uiux: MousePointerClick, web: CodeXml, poster: Palette, reels: Clapperboard } as const;

/** Ukuran PDF guidebook, dibaca saat build dari folder public/. */
function pdfSize(publicPath: string): string | null {
  try {
    const bytes = fs.statSync(path.join(process.cwd(), 'public', publicPath)).size;
    return `${Math.round(bytes / 1024)} KB`;
  } catch {
    console.warn(`[Digital Canvas] Guidebook tidak ditemukan: public${publicPath}`);
    return null;
  }
}

const items = event.competitions.map((c, i) => ({
  ...c,
  no: String(i + 1).padStart(2, '0'),
  Icon: ICONS[c.id as keyof typeof ICONS] ?? FileText,
  size: pdfSize(c.guidebook),
}));
---

<section id="lomba" class="section on-light bg-paper max-sm:[--hm:2]" aria-labelledby="lomba-title">
  <div class="wrap flex flex-col max-sm:min-h-[calc(200svh-var(--padt)-var(--padb))]">
    <div class="grid gap-y-4 lg:grid-cols-12 lg:gap-x-6">
      <div class="lg:col-span-7">
        <p class="label text-muted">Lomba</p>
        <h2 id="lomba-title" class="h2 mt-4">Cabang lomba</h2>
      </div>
      <p class="max-w-[44ch] text-lead lg:col-span-5 lg:col-start-8">
        {`Pilih satu cabang lomba. Sub-tema UI/UX Design, Web Design, dan Poster Design: ${event.subthemes.join(', ').replace(/, ([^,]*)$/, ', dan $1')}.`}
      </p>
    </div>

    <ol class="mt-6 flex flex-col border-b sm:mt-8 border-line max-sm:flex-1 max-sm:justify-between lg:mt-10">
      {
        items.map((c) => (
          <li id={`lomba-${c.id}`} class="grid gap-y-3 border-t border-line py-4 sm:py-5 md:grid-cols-12 md:gap-x-6">
            <div class="flex items-center gap-4 md:col-span-4">
              <span class="font-display text-small font-semibold text-teal-deep" aria-hidden="true">
                {c.no}
              </span>
              <c.Icon size={30} stroke-width={1.5} aria-hidden="true" class="shrink-0 text-teal-deep" />
              <h3 class="font-display text-[clamp(1.75rem,1.3rem+1.4vw,2.5rem)] leading-none font-semibold uppercase">
                {c.name}
              </h3>
            </div>

            <div class="md:col-span-5">
              <p class="max-w-[52ch]">{c.summary}</p>
              <ul class="mt-2.5 flex flex-wrap gap-x-5 gap-y-1.5 text-small text-muted">
                <li class="inline-flex items-start gap-1.5">
                  <Users size={15} aria-hidden="true" class="mt-[3px] shrink-0" />
                  {c.team}
                </li>
                <li class="inline-flex items-start gap-1.5">
                  <Flag size={15} aria-hidden="true" class="mt-[3px] shrink-0" />
                  {c.rounds}
                </li>
                {c.contact && (
                  <li class="inline-flex items-start gap-1.5">
                    <MessageCircle size={15} aria-hidden="true" class="mt-[3px] shrink-0 text-teal-deep" />
                    <span>
                      Narahubung: <a href={c.contact.whatsapp} target="_blank" rel="noopener noreferrer" class="font-medium text-ink underline underline-offset-2 hover:text-teal-deep" title={`Hubungi WhatsApp ${c.contact.name}`}>{c.contact.name} ({c.contact.phone})</a>
                    </span>
                  </li>
                )}
              </ul>
            </div>

            <div class="flex flex-col items-start gap-1.5 md:col-span-3 md:items-end">
              <a
                href={c.guidebook}
                target="_blank"
                rel="noopener noreferrer"
                class="btn btn--secondary w-full md:w-auto"
                data-guidebook={c.id}
              >
                <FileText size={18} aria-hidden="true" />
                Lihat guidebook
                {c.size && <span class="text-small font-normal opacity-75 md:hidden">· PDF {c.size}</span>}
                <span class="sr-only">{`${c.name} (PDF, membuka tab baru)`}</span>
              </a>
              <div class="flex flex-wrap items-center gap-x-2 text-label text-muted">
                {c.size && <span>PDF · {c.size}</span>}
                {c.contact && (
                  <>
                    <span aria-hidden="true" class="hidden md:inline">·</span>
                    <a
                      href={c.contact.whatsapp}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="hidden font-medium text-teal-deep hover:underline md:inline-flex items-center gap-1"
                      title={`Hubungi WhatsApp ${c.contact.name}`}
                    >
                      <MessageCircle size={13} aria-hidden="true" />
                      CP: {c.contact.name}
                    </a>
                  </>
                )}
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
