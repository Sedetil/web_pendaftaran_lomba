---
import { ArrowUpRight, CalendarClock, CalendarX2, Wallet, Lock } from '@lucide/astro';
import { event } from '../data/event';
import { TBA, formatDate, formatRange, isValidFormUrl } from '../utils/event-helpers';

const reg = event.registration;
const period = reg.open && !reg.close ? `Mulai ${formatDate(reg.open)}` : formatRange(reg.open, reg.close);
const info = [
  { icon: CalendarClock, label: 'Periode pendaftaran', value: period },
  { icon: CalendarX2, label: 'Batas akhir', value: formatDate(reg.close) },
  { icon: Wallet, label: 'Biaya', value: reg.fee },
];
const formUrl = isValidFormUrl(reg.formUrl) ? reg.formUrl : null;
const names = event.competitions.map((c) => c.name);
---

<section
  id="registration"
  class="section on-dark grain relative isolate overflow-hidden max-sm:[--hm:2] bg-[linear-gradient(165deg,var(--color-ocean)_0%,var(--color-abyss)_100%)] text-paper "
  aria-labelledby="registration-title"
>
  <div class="wrap grid gap-y-10 sm:gap-y-12 max-sm:grid-rows-[auto_1fr] max-sm:min-h-[calc(200svh-var(--padt)-var(--padb))] md:grid-cols-12 md:gap-x-6">
    <!-- Kiri: informasi pendaftaran -->
    <div class="md:col-span-6 lg:col-span-7">
      <p class="label text-on-dark-muted">Registration</p>
      <h2 id="registration-title" class="h2 mt-4">Pendaftaran <span class="text-peach">peserta</span></h2>
      <p class="mt-5 max-w-[46ch] text-lead">
        Satu formulir untuk semua cabang lomba. Pilih cabang lombamu, lalu isi Google Form sampai terkirim.
      </p>

      <dl class="mt-6 max-w-[34rem] border-t border-line-dark sm:mt-8">
        {
          info.map(({ icon: Icon, label, value }) => (
            <div class="grid grid-cols-[1.25rem_1fr] items-center gap-x-4 gap-y-1 border-b border-line-dark py-3 sm:flex sm:py-3.5">
              <Icon size={20} aria-hidden="true" class="shrink-0 text-peach" />
              <dt class="text-label font-medium tracking-wide text-on-dark-muted uppercase">{label}</dt>
              <dd class:list={['col-start-2 font-display text-[1.1875rem] leading-tight font-medium sm:ml-auto sm:text-right', !value && 'text-peach']}>
                {value ?? TBA}
              </dd>
            </div>
          ))
        }
      </dl>

      <h3 class="mt-6 text-h3 font-semibold uppercase sm:mt-8">Persyaratan peserta</h3>
      {
        reg.requirements.length ? (
          <ul class="mt-3 space-y-1.5 sm:space-y-2">
            {reg.requirements.map((r) => (
              <li class="flex gap-3">
                <span class="mt-[0.75em] h-px w-4 shrink-0 bg-peach" aria-hidden="true" />
                {r}
              </li>
            ))}
          </ul>
        ) : (
          <p class="mt-3 max-w-[44ch]">
            <span class="font-semibold text-peach">{TBA}.</span> Persyaratan lengkap tercantum di guidebook tiap lomba.
          </p>
        )
      }
    </div>

    <!-- Kanan: cara mendaftar + tiket formulir pendaftaran lomba -->
    <div class="max-sm:self-end md:col-span-6 md:col-start-7 lg:col-span-5 lg:col-start-8">
      <h3 class="text-h3 font-semibold uppercase">Cara mendaftar</h3>
      <ol class="mt-3 space-y-1.5">
        {
          reg.steps.map((s, i) => (
            <li class="grid grid-cols-[2rem_1fr] items-baseline gap-1">
              <span class="font-display text-[1.25rem] font-semibold text-peach">{i + 1}.</span>
              <span>{s}</span>
            </li>
          ))
        }
      </ol>

      <ul class="mt-6 sm:mt-8" aria-label="Formulir pendaftaran">
      <li id="daftar-lomba" class="grid overflow-hidden rounded-md bg-paper text-ink xl:grid-cols-[1fr_auto]">
        <div class="px-5 py-4 sm:px-8 sm:py-6">
          <p class="font-display text-small font-semibold text-teal-deep">{event.series}</p>
          <h3 class="mt-2 font-display text-[clamp(1.75rem,1.2rem+1.6vw,2.875rem)] leading-[0.95] font-bold uppercase">
            Competition
          </h3>
          <p class="mt-2 max-w-[40ch]">Formulir pendaftaran {names.slice(0, -1).join(', ')}, dan {names.at(-1)}.</p>
          <div class="mt-5">
            {formUrl ? (
              <a href={formUrl} target="_blank" rel="noopener noreferrer" class="btn btn--primary-light w-full xl:w-auto" data-form-link>
                Isi formulir pendaftaran
                <ArrowUpRight size={18} aria-hidden="true" />
                <span class="sr-only">(Google Form, membuka tab baru)</span>
              </a>
            ) : (
              <span class="btn w-full text-muted xl:w-auto" aria-disabled="true">
                <Lock size={16} aria-hidden="true" />
                Formulir belum dibuka
              </span>
            )}
          </div>
        </div>
        <!-- sobekan tiket -->
        <div
          class="relative hidden w-20 border-l-2 border-dashed border-ink/20 bg-surface xl:flex xl:items-center xl:justify-center"
          aria-hidden="true"
        >
          <div class="barcode h-[64%] w-6 text-ink/70 [background-image:repeating-linear-gradient(0deg,currentColor_0_2px,transparent_2px_5px,currentColor_5px_6px,transparent_6px_9px,currentColor_9px_12px,transparent_12px_14px,currentColor_14px_15px,transparent_15px_19px)]"></div>
        </div>
      </li>
      </ul>
      <p class="mt-4 text-small text-on-dark-muted">
        Formulir membuka Google Form resmi panitia di tab baru. Batas akhir {formatDate(reg.close)}.
      </p>
    </div>
  </div>
</section>
