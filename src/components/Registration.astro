---
import fs from 'node:fs';
import path from 'node:path';
import { CalendarClock, Wallet, FileDown, IdCard, Users, Layers, Signature, School, CircleCheck } from '@lucide/astro';
import IconTile from './IconTile.astro';

/** Ikon persyaratan dipilih dari kata kunci, jadi tetap cocok bila urutan diubah. */
function reqIcon(text: string) {
  const t = text.toLowerCase();
  if (t.includes('surat pernyataan')) return Signature;
  if (t.includes('kartu pelajar') || t.includes('siswa/i')) return IdCard;
  if (t.includes('tim') || t.includes('perorangan')) return Users;
  if (t.includes('cabang')) return Layers;
  if (t.includes('sekolah')) return School;
  return CircleCheck;
}
import { event } from '../data/event';
import { TBA, formatDate, formatRange } from '../utils/event-helpers';

const reg = event.registration;
const period = reg.open && !reg.close ? `Mulai ${formatDate(reg.open)}` : formatRange(reg.open, reg.close);
const info = [
  { icon: CalendarClock, label: 'Pendaftaran & pengumpulan', value: period },
  { icon: Wallet, label: 'Biaya pendaftaran', value: reg.fee },
];

const statementDocPath = '/dokumen/surat-pernyataan-keaslian-karya.docx';

/** Ukuran berkas dokumen, dibaca saat build dari folder public/. */
function docSize(publicPath: string): string {
  try {
    const bytes = fs.statSync(path.join(process.cwd(), 'public', publicPath)).size;
    return `${Math.round(bytes / 1024)} KB`;
  } catch {
    return '18 KB';
  }
}

const docBytes = docSize(statementDocPath);
---

<section
  id="registration"
  class="section on-dark grain relative isolate overflow-hidden max-sm:[--hm:2] bg-[linear-gradient(165deg,var(--color-ocean)_0%,var(--color-abyss)_100%)] text-paper "
  aria-labelledby="registration-title"
>
  <div class="wrap grid gap-y-10 sm:gap-y-12 max-sm:grid-rows-[auto_1fr] max-sm:min-h-[calc(200svh-var(--padt)-var(--padb))] md:grid-cols-12 md:gap-x-6">
    <!-- Kiri: informasi pendaftaran & persyaratan -->
    <div class="md:col-span-6 lg:col-span-7">
      <p class="label text-on-dark-muted">Registration</p>
      <h2 id="registration-title" class="h2 mt-4">Pendaftaran <span class="text-peach">peserta</span></h2>
      <p class="mt-5 max-w-[48ch] rounded-sm border-l-2 border-peach bg-paper/10 px-4 py-3 text-lead text-paper">
        Semua link pendaftaran dan pengumpulan tertera di masing-masing guidebook cabang lomba.
      </p>

      <dl class="mt-6 max-w-[34rem] border-t border-line-dark sm:mt-8">
        {
          info.map(({ icon: Icon, label, value }) => (
            <div class="grid grid-cols-[1.25rem_1fr] items-center gap-x-4 gap-y-1 border-b border-line-dark py-3.5 sm:flex">
              <Icon size={20} aria-hidden="true" class="shrink-0 text-peach" />
              <dt class="text-label font-medium tracking-wide text-on-dark-muted uppercase">{label}</dt>
              <dd class:list={['col-start-2 font-display text-[1.125rem] leading-tight font-medium sm:ml-auto sm:text-right', !value && 'text-peach']}>
                {value ?? TBA}
              </dd>
            </div>
          ))
        }
      </dl>

      <h3 class="mt-6 text-h3 font-semibold uppercase sm:mt-8">Persyaratan peserta</h3>
      {
        reg.requirements.length ? (
          <ul class="mt-4 grid gap-2.5">
            {reg.requirements.map((r) => {
              const isSurat = r.includes('Surat Pernyataan Keaslian Karya');
              return (
                <li class="flex items-center gap-3 text-[0.9375rem] leading-snug text-paper/90">
                  <IconTile icon={reqIcon(r)} tone="dark" size="sm" />
                  <span>
                    {isSurat ? (
                      <>
                        Melampirkan{' '}
                        <a
                          href={statementDocPath}
                          download="SURAT PERNYATAAN KEASLIAN KARYA.docx"
                          class="font-semibold text-peach underline underline-offset-4 hover:text-peach-soft"
                          title="Unduh template Surat Pernyataan Keaslian Karya (.docx)"
                        >
                          Surat Pernyataan Keaslian Karya
                        </a>{' '}
                        yang telah diisi dan ditandatangani.
                      </>
                    ) : (
                      r
                    )}
                  </span>
                </li>
              );
            })}
          </ul>
        ) : (
          <p class="mt-3 max-w-[44ch]">
            <span class="font-semibold text-peach">{TBA}.</span> Persyaratan lengkap tercantum di guidebook tiap lomba.
          </p>
        )
      }
    </div>

    <!-- Kanan: cara mendaftar + tiket berkas pendaftaran lomba -->
    <div class="max-sm:self-end md:col-span-6 md:col-start-7 lg:col-span-5 lg:col-start-8">
      <h3 class="text-h3 font-semibold uppercase">Cara mendaftar</h3>
      <ol class="mt-3 space-y-2">
        {
          reg.steps.map((s, i) => (
            <li class="grid grid-cols-[2rem_1fr] items-baseline gap-1 text-[0.9375rem] leading-relaxed text-paper/90">
              <span class="font-display text-[1.25rem] font-semibold text-peach">{i + 1}.</span>
              <span>{s}</span>
            </li>
          ))
        }
      </ol>

      <ul class="mt-6 sm:mt-8" aria-label="Berkas pendaftaran">
        <li id="daftar-lomba" class="grid overflow-hidden rounded-md bg-paper text-ink xl:grid-cols-[1fr_auto]">
          <div class="px-5 py-5 sm:px-8 sm:py-6">
            <div class="flex flex-wrap items-center justify-between gap-2">
              <p class="font-display text-small font-semibold tracking-wide text-teal-deep uppercase">
                {event.series}
              </p>
              <span class="inline-flex shrink-0 items-center rounded bg-teal-deep/10 px-2.5 py-0.5 text-label font-semibold text-teal-deep">
                DOCX · {docBytes}
              </span>
            </div>
            <h3 class="mt-2 font-display text-[clamp(1.75rem,1.2rem+1.6vw,2.5rem)] leading-[0.95] font-bold uppercase">
              Surat Orisinil
            </h3>
            <p class="mt-2.5 max-w-[42ch] text-small text-muted leading-relaxed">
              Format resmi bertandatangan yang wajib dilampirkan saat pengumpulan karya.
            </p>
            <div class="mt-5">
              <a
                href={statementDocPath}
                download="SURAT PERNYATAAN KEASLIAN KARYA.docx"
                class="btn btn--primary-light w-full text-center whitespace-normal sm:whitespace-nowrap xl:w-auto"
                data-download-surat
              >
                <FileDown size={18} aria-hidden="true" />
                Unduh Surat Orisinil (.docx)
              </a>
            </div>
          </div>
          <!-- sobekan tiket -->
          <div
            class="relative hidden w-20 border-l-2 border-dashed border-ink/20 bg-surface xl:flex xl:items-center xl:justify-center"
            aria-hidden="true"
          >
            <div class="barcode h-[64%] w-6 text-ink/70 [background-image:repeating-linear-gradient(0deg,currentColor_0_2px,transparent_2px_5px,currentColor_5px_6px,transparent_6px_9px,currentColor_9px_12px,transparent_12px_14px,currentColor_14px_15px,transparent_15px_19px)]"></div>
          </div>
        </li>
      </ul>
    </div>
  </div>
</section>
