---
import fs from 'node:fs';
import path from 'node:path';
import { MessageCircle, GraduationCap, School } from '@lucide/astro';
import { event } from '../data/event';


const trplLogoPath = '/assets/logo/logo-trpl.png';
const smk8LogoPath = '/assets/logo/logo-smk-8-balam.png';

const hasTrplLogo = fs.existsSync(path.join(process.cwd(), 'public', trplLogoPath));
const hasSmk8Logo = fs.existsSync(path.join(process.cwd(), 'public', smk8LogoPath));
---

<section id="partners" class="section on-light bg-surface" aria-labelledby="partners-title">
  <div class="wrap flex flex-col">
    <!-- Header: Partner & Sponsor digabung -->
    <div class="grid gap-y-4 lg:grid-cols-12 lg:gap-x-6">
      <div class="lg:col-span-7">
        <p class="label text-muted">Partner & Sponsor</p>
        <h2 id="partners-title" class="h2 mt-4">Partner & <span class="text-teal-deep">Sponsor</span></h2>
      </div>
      <p class="max-w-[44ch] text-lead lg:col-span-5 lg:col-start-8">
        Didukung oleh kolaborasi institusi pendidikan dan kemitraan dalam penyelenggaraan {event.name} {event.series}.
      </p>
    </div>

    <!-- Logonya di bawahnya: TRPL dan SMK 8 -->
    <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:mt-12">
      <!-- TRPL Polinela -->
      <div class="flex flex-col justify-between rounded-md border border-line bg-paper p-6 sm:p-8">
        <div class="flex items-center justify-between border-b border-line pb-4">
          <div>
            <span class="font-display text-small font-semibold tracking-wider text-teal-deep uppercase">TRPL Polinela</span>
            <p class="text-label text-muted">Penyelenggara Utama</p>
          </div>
          <GraduationCap size={20} class="text-teal-deep" aria-hidden="true" />
        </div>
        <div class="my-6 flex min-h-[140px] items-center justify-center rounded border border-line/60 bg-surface/40 p-6 text-center">
          {hasTrplLogo ? (
            <img
              src={trplLogoPath}
              alt="Logo TRPL Politeknik Negeri Lampung"
              class="max-h-24 max-w-[200px] object-contain"
              loading="lazy"
            />
          ) : (
            <div class="flex flex-col items-center">
              <div class="flex h-14 w-14 items-center justify-center rounded-md bg-teal-deep/10 text-teal-deep font-display font-bold text-xl">
                TRPL
              </div>
              <p class="mt-2 font-display text-[1.125rem] font-semibold text-ink">TRPL Polinela</p>
              <p class="text-label text-muted">Logo menyusul</p>
            </div>
          )}
        </div>
        <p class="text-small text-muted">Program Studi Teknologi Rekayasa Perangkat Lunak, Politeknik Negeri Lampung.</p>
      </div>

      <!-- SMK 8 Bandar Lampung -->
      <div class="flex flex-col justify-between rounded-md border border-line bg-paper p-6 sm:p-8">
        <div class="flex items-center justify-between border-b border-line pb-4">
          <div>
            <span class="font-display text-small font-semibold tracking-wider text-teal-deep uppercase">SMKN 8 Bandar Lampung</span>
            <p class="text-label text-muted">Mitra & Lokasi Final</p>
          </div>
          <School size={20} class="text-teal-deep" aria-hidden="true" />
        </div>
        <div class="my-6 flex min-h-[140px] items-center justify-center rounded border border-line/60 bg-surface/40 p-6 text-center">
          {hasSmk8Logo ? (
            <img
              src={smk8LogoPath}
              alt="Logo SMK Negeri 8 Bandar Lampung"
              class="max-h-24 max-w-[180px] object-contain"
              loading="lazy"
            />
          ) : (
            <div class="flex flex-col items-center">
              <School size={36} class="text-teal-deep" aria-hidden="true" />
              <p class="mt-2 font-display text-[1.125rem] font-semibold text-ink">SMKN 8 Bandar Lampung</p>
              <p class="text-label text-muted">Logo menyusul</p>
            </div>
          )}
        </div>
        <p class="text-small text-muted">Mitra institusi vokasi sekaligus lokasi pelaksanaan babak final tatap muka.</p>
      </div>
    </div>
  </div>
</section>
