---
/** Wordmark Digital Canvas: DIGITAL off-white + CANVAS peach dalam bingkai tipis. */
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2.5 font-display uppercase leading-none', className]}>
  <svg width="26" height="26" viewBox="0 0 26 26" aria-hidden="true" class="shrink-0">
    <rect x="1.5" y="1.5" width="23" height="23" fill="none" stroke="currentColor" stroke-width="1.5" opacity=".6"></rect>
    <rect x="6" y="6" width="9" height="9" fill="#F0BCA5"></rect>
    <rect x="11" y="11" width="9" height="9" fill="none" stroke="currentColor" stroke-width="1.5"></rect>
  </svg>
  <span class="text-[1.25rem] font-semibold tracking-[0.02em]">
    Digital <span class="text-peach">Canvas</span>
  </span>
</span>
